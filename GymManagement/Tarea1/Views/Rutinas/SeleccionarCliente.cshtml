@model IEnumerable<Tarea1.Models.Entities.Cliente>
@{
    Layout = ViewData["Layout"] as string;
    ViewData["Title"] = "Seleccionar Cliente";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-dark">Rutinas de Ejercicios</h1>
            <p class="text-muted">Seleccione un cliente para ver, crear o asignar sus rutinas de entrenamiento.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="py-3">Nombre</th>
                            <th class="py-3">Cédula</th>
                            <th class="py-3">Correo</th>
                            <th class="py-3">Teléfono</th>
                            <th class="py-3 text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="py-3 fw-bold">@item.Nombre @item.Apellido</td>
                                <td class="py-3 text-muted">@item.Cedula</td>
                                <td class="py-3 text-muted">@item.Correo</td>
                                <td class="py-3 text-muted">@item.Telefono</td>
                                <td class="py-3 text-end">
                                    <a asp-action="Index" asp-route-idCliente="@item.IdCliente" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold">
                                        Ver Rutinas
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
