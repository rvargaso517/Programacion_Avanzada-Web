@model IEnumerable<Tarea1.Models.Entities.Rutina>
@{
    Layout = ViewData["Layout"] as string;
    ViewData["Title"] = "Rutinas de " + ViewBag.ClienteNombre;
    var userRol = Context.Session.GetInt32("Rol");
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-dark">Rutinas: @ViewBag.ClienteNombre</h1>
            <p class="text-muted">Historial de rutinas asignadas a este cliente.</p>
        </div>
        @if (userRol == 1 || userRol == 3)
        {
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 me-2 fw-bold">
                    Volver a Clientes
                </a>
                <a asp-action="Create" asp-route-idCliente="@ViewBag.IdCliente" class="btn btn-warning rounded-pill px-4 fw-bold">
                    + Asignar Rutina
                </a>
            </div>
        }
    </div>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-info text-center rounded-3 shadow-sm">
            @ViewBag.Mensaje
        </div>
    }
    else if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center p-5">
            <div class="py-5">
                <i class="bi bi-journal-x display-1 text-muted"></i>
                <h3 class="mt-3 fw-bold">No hay rutinas asignadas</h3>
                <p class="text-muted">Aún no se han diseñado planes de entrenamiento para este cliente.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 position-relative hover-shadow transition">
                        <div class="card-body p-4 d-flex flex-column">
                            <span class="badge bg-warning text-dark align-self-start mb-2 px-3 py-2 rounded-pill fw-bold">
                                @item.FechaAsignacion.ToString("dd/MM/yyyy")
                            </span>
                            <h4 class="card-title fw-bold mb-2">@item.NombreRutina</h4>
                            <p class="text-muted text-truncate flex-grow-1">@(string.IsNullOrEmpty(item.Descripcion) ? "Sin descripción" : item.Descripcion)</p>
                            <div class="border-top pt-3 mt-3 d-flex justify-content-between align-items-center">
                                <span class="text-muted small">
                                    Por: <strong>@item.EntrenadorNombre</strong>
                                </span>
                                <div class="d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@item.IdRutina" class="btn btn-outline-warning btn-sm rounded-pill px-3">
                                        Ver Detalles
                                    </a>
                                    @if (userRol == 1 || userRol == 3)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.IdRutina" class="btn btn-outline-info btn-sm rounded-pill px-3">
                                            Editar
                                        </a>
                                        <form asp-action="Delete" method="post" onsubmit="return confirm('¿Está seguro de eliminar esta rutina?');">
                                            <input type="hidden" name="id" value="@item.IdRutina" />
                                            <input type="hidden" name="idCliente" value="@ViewBag.IdCliente" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">
                                                Eliminar
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
