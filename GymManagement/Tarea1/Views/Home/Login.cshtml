@using GymManagement_WEB.Models
@model UsuarioModel

@{
    Layout = "_AccesoLayout";
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="card border-0 shadow-lg rounded-4">

    <div class="card-body p-5">

        <div class="text-center mb-4">

            <img src="~/imagenes/logo.png"
                 width="120"
                 class="mb-3" />

            <h2 class="fw-bold">
                Iniciar Sesión
            </h2>

            <p class="text-muted">
                Bienvenido a Gym Management
            </p>

        </div>

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-danger text-center">
                @ViewBag.Mensaje
            </div>
        }
        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Exito"]
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }
        <form asp-action="Login"
              asp-controller="Home"
              method="post">

            <div class="mb-3">

                <label asp-for="Correo" class="form-label">
                    Correo Electrónico
                </label>

                <input asp-for="Correo"
                       class="form-control form-control-lg"
                       placeholder="Ingrese su correo" />
                <span asp-validation-for="Correo" class="text-danger"></span>

            </div>

            <div class="mb-4">

                <label asp-for="Contrasenna" class="form-label">
                    Contraseña
                </label>

                <div class="input-group">
                    <input asp-for="Contrasenna"
                           type="password"
                           id="txtContrasenna"
                           class="form-control form-control-lg"
                           placeholder="Ingrese su contraseña" />
                    <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('txtContrasenna', this)">
                        <i class="fa fa-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Contrasenna" class="text-danger"></span>

            </div>

            <button type="submit"
                    class="btn btn-warning w-100 btn-lg">

                Iniciar Sesión

            </button>

        </form>

        <hr />

        <div class="text-center">

            <p>

                ¿No tiene una cuenta?

                <a asp-action="Registro"
                   asp-controller="Home">

                    Registrarse

                </a>

            </p>

            <a asp-action="RecuperarAcceso"
               asp-controller="Home">

                ¿Olvidó su contraseña?

            </a>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}