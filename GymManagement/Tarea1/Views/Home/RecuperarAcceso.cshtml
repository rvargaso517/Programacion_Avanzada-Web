@{
    Layout = "_AccesoLayout";
    ViewData["Title"] = "Recuperar Acceso";
}

<div class="card border-0 shadow-lg rounded-4">
    <div class="card-body p-5">
        <div class="text-center mb-4">
            <img src="~/imagenes/logo.png" width="120" class="mb-3" alt="Logo" />
            <h2 class="fw-bold">Recuperar Acceso</h2>
            <p class="text-muted">Ingresa tu correo para recibir las instrucciones de recuperación.</p>
        </div>

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-danger text-center">
                @ViewBag.Mensaje
            </div>
        }

        <form asp-action="RecuperarAcceso" asp-controller="Home" method="post">
            <div class="mb-4">
                <label for="correo" class="form-label">Correo Electrónico</label>
                <input type="email" id="correo" name="correo" class="form-control form-control-lg" placeholder="ejemplo@correo.com" required />
            </div>

            <button type="submit" class="btn btn-warning w-100 btn-lg mb-3">
                Enviar Enlace de Recuperación
            </button>
        </form>

        <hr />

        <div class="text-center">
            <p class="mb-0">
                ¿Recordaste tu contraseña? 
                <a asp-action="Login" asp-controller="Home" class="text-warning fw-bold">Iniciar Sesión</a>
            </p>
        </div>
    </div>
</div>
