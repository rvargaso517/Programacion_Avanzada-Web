@model IEnumerable<Tarea1.Models.Dtos.PlanDto>
@using Tarea1.Models
@{
    Layout = "_Layout";
    var contenido = ViewBag.Contenido as ContenidoPaginaModel ?? new ContenidoPaginaModel();
    var choseUs = contenido.ChoseUs;
    var classes = contenido.Classes;
}

    <!-- Hero Section Begin -->
    <section class="hero-section">
        <div class="hs-slider owl-carousel">
            <div class="hs-item set-bg" data-setbg="/imagenes/hero-1.jpg">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-6 offset-lg-6">
                            <div class="hi-text">
                                <span>Moldea tu cuerpo</span>
                                <h1>Se <strong>fuerte</strong> entrenando duro</h1>
                                <a href="#" class="primary-btn">Obtener información</a>
                            </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Hero Section End -->
    <!-- ChoseUs Section Begin -->
    <section class="choseus-section spad" id="about">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="section-title">
                        <span>@(choseUs?.Subtitulo ?? "¿Por qué elegirnos?")</span>
                        <h2>@(choseUs?.Titulo ?? "SUPERA TUS LÍMITES")</h2>
                    </div>
                </div>
            </div>
            <div class="row">
                @if (choseUs?.Items != null)
                {
                    for (int i = 0; i < choseUs.Items.Count; i++)
                    {
                        var item = choseUs.Items[i];
                        var iconClass = i switch
                        {
                            0 => "flaticon-034-stationary-bike",
                            1 => "flaticon-033-juice",
                            2 => "flaticon-002-dumbell",
                            3 => "flaticon-014-heart-beat",
                            _ => "flaticon-002-dumbell"
                        };
                        <div class="col-lg-3 col-sm-6">
                            <div class="cs-item">
                                <span class="@iconClass"></span>
                                <h4>@item.Titulo</h4>
                                <p>@item.Descripcion</p>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </section>
    <!-- ChoseUs Section End -->
    <!-- Classes Section Begin -->
    <section class="classes-section spad" id="classes">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="section-title">
                        <span>@(classes?.Subtitulo ?? "Nuestras Clases")</span>
                        <h2>@(classes?.Titulo ?? "QUÉ PODEMOS OFRECER")</h2>
                    </div>
                </div>
            </div>
            <div class="row">
                @if (classes?.Items != null)
                {
                    for (int i = 0; i < classes.Items.Count; i++)
                    {
                        var item = classes.Items[i];
                        var colClass = (i < 3) ? "col-lg-4 col-md-6" : "col-lg-6 col-md-6";
                        <div class="@colClass">
                            <div class="class-item">
                                <div class="ci-pic">
                                    <img src="@item.Imagen" alt="">
                                </div>
                                <div class="ci-text">
                                    <span>@item.Categoria</span>
                                    <h5>@item.Titulo</h5>
                                    <a href="#"><i class="fa fa-angle-right"></i></a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </section>
    <!-- Classes Section End -->
    <!-- Banner Section Begin -->
    <section class="banner-section set-bg" data-setbg="img/banner-bg.jpg">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 text-center">
                    <div class="bs-text">
                        <h2>Regístrate ahora para obtener más ofertas</h2>
                        <div class="bt-tips">Donde la salud, belleza y fitness se encuentran.</div>
                        <a href="#" class="primary-btn  btn-normal">Cita</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Banner Section End -->
    <!-- Pricing Section Begin -->
    <section class="pricing-section spad" id="services">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="section-title">
                        <span>Nuestro Plan</span>
                        <h2>Elige tu plan de precios</h2>
                    </div>
                </div>
            </div>
            <div class="row justify-content-center">
                @if (Model != null && Model.Any())
                {
                    foreach (var plan in Model)
                    {
                        <div class="col-lg-4 col-md-8">
                            <div class="ps-item">
                                <h3>@plan.Nombre</h3>
                                <div class="pi-price">
                                    <h2>₡@plan.Precio.ToString("N0")</h2>
                                    <span>@plan.DuracionDias DÍAS</span>
                                </div>
                                <ul>
                                    <li>@plan.Descripcion</li>
                                    <li>Paseo libre</li>
                                    <li>Equipos ilimitados</li>
                                    <li>Entrenador personal</li>
                                    <li>Sin restricción de tiempo</li>
                                </ul>
                                @if (Context.Session.GetString("Autenticado") == "1")
                                {
                                    <a asp-controller="Membresias" asp-action="Create" asp-route-idPlan="@plan.IdPlan" class="primary-btn pricing-btn">Adquirir plan</a>
                                }
                                else
                                {
                                    <a asp-controller="Home" asp-action="Registro" class="primary-btn pricing-btn">Inscribirse ahora</a>
                                }
                                <a href="#" class="thumb-icon"><i class="fa fa-picture-o"></i></a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center text-muted">
                        <p>No hay planes de precios disponibles en este momento.</p>
                    </div>
                }
            </div>
        </div>
    </section>
    <!-- Pricing Section End -->
    <!-- Gallery Section Begin -->
    <div class="gallery-section">
        <div class="gallery">
            <div class="grid-sizer"></div>
            <div class="gs-item grid-wide set-bg" data-setbg="/imagenes/gallery-1.jpg">
                <a href="~/imagenes/gallery-1.jpg" class="thumb-icon image-popup"><i class="fa fa-picture-o"></i></a>
            </div>
            <div class="gs-item set-bg" data-setbg="/imagenes/gallery-2.jpg">
                <a href="~/imagenes/gallery-2.jpg" class="thumb-icon image-popup"><i class="fa fa-picture-o"></i></a>
            </div>
            <div class="gs-item set-bg" data-setbg="/imagenes/gallery-3.jpg">
                <a href="~/imagenes/gallery-3.jpg" class="thumb-icon image-popup"><i class="fa fa-picture-o"></i></a>
            </div>
            <div class="gs-item set-bg" data-setbg="/imagenes/gallery-4.jpg">
                <a href="~/imagenes/gallery-4.jpg" class="thumb-icon image-popup"><i class="fa fa-picture-o"></i></a>
            </div>
            <div class="gs-item set-bg" data-setbg="/imagenes/gallery-5.jpg">
                <a href="~/imagenes/gallery-5.jpg" class="thumb-icon image-popup"><i class="fa fa-picture-o"></i></a>
            </div>
            <div class="gs-item grid-wide set-bg" data-setbg="/imagenes/gallery-6.jpg">
                <a href="~/imagenes/gallery-6.jpg" class="thumb-icon image-popup"><i class="fa fa-picture-o"></i></a>
            </div>
        </div>
    </div>
    <!-- Gallery Section End -->
    <!-- Team Section Begin -->
    <section class="team-section spad" id="team">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="team-title">
                        <div class="section-title">
                            <span>@(contenido.Team?.Subtitulo ?? "Nuestro Equipo")</span>
                            <h2>@(contenido.Team?.Titulo ?? "ENTRENA CON EXPERTOS")</h2>
                        </div>
                        <a href="#" class="primary-btn btn-normal appoinment-btn">cita</a>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="ts-slider owl-carousel">
                    @if (contenido.Team?.Items != null)
                    {
                        foreach (var trainer in contenido.Team.Items)
                        {
                            <div class="col-lg-4">
                                <div class="ts-item set-bg" data-setbg="@trainer.Imagen">
                                    <div class="ts_text">
                                        <h4>@trainer.Nombre</h4>
                                        <span>@trainer.Especialidad</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </section>
    <!-- Team Section End -->
    <!-- Contacto Section Begin -->
    <div class="gettouch-section" id="contact">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <div class="gt-text">
                        <i class="fa fa-map-marker"></i>
                        <p>333 Middle Winchendon Rd, Rindge,<br /> NH 03461</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="gt-text">
                        <i class="fa fa-mobile"></i>
                        <ul>
                            <li>125-711-811</li>
                            <li>125-668-886</li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="gt-text email">
                        <i class="fa fa-envelope"></i>
                        <p>Support.gymcenter@gmail.com</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Contacto Section End -->
    <!-- Search model Begin -->
    <div class="search-model">
        <div class="h-100 d-flex align-items-center justify-content-center">
            <div class="search-close-switch">+</div>
            <form class="search-model-form">
                <input type="text" id="search-input" placeholder="Buscar aquí.....">
            </form>
        </div>
    </div>
    <!-- Search model end -->
