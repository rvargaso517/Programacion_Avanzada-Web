    <!-- Banner Section Begin -->
    <section class="banner-section set-bg" data-setbg="img/banner-bg.jpg">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 text-center">
                    <div class="bs-text">
                        <h2>Regístrate ahora para obtener más ofertas</h2>
                        <div class="bt-tips">Donde la salud, belleza y fitness se encuentran.</div>
                        <a href="#" class="primary-btn  btn-normal">Cita</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Banner Section End -->
    <!-- Pricing Section Begin -->
    <section class="pricing-section spad" id="services">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="section-title">
                        <span>Nuestro Plan</span>
                        <h2>Elige tu plan de precios</h2>
                    </div>
                </div>
            </div>
            <div class="row justify-content-center">
                @if (Model != null && Model.Any())
                {
                    foreach (var plan in Model)
                    {
                        <div class="col-lg-4 col-md-8">
                            <div class="ps-item">
                                <h3>@plan.Nombre</h3>
                                <div class="pi-price">
                                    <h2>₡@plan.Precio.ToString("N0")</h2>
                                    <span>@plan.DuracionDias DÍAS</span>
                                </div>
                                <ul>
                                    <li>@plan.Descripcion</li>
                                    <li>Paseo libre</li>
                                    <li>Equipos ilimitados</li>
                                    <li>Entrenador personal</li>
                                    <li>Sin restricción de tiempo</li>
                                </ul>
                                @if (Context.Session.GetString("Autenticado") == "1")
                                {
                                    <a asp-controller="Membresias" asp-action="Create" asp-route-idPlan="@plan.IdPlan" class="primary-btn pricing-btn">Adquirir plan</a>
                                }
                                else
                                {
                                    <a asp-controller="Home" asp-action="Registro" class="primary-btn pricing-btn">Inscribirse ahora</a>
                                }
                                <a href="#" class="thumb-icon"><i class="fa fa-picture-o"></i></a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center text-muted">
                        <p>No hay planes de precios disponibles en este momento.</p>
                    </div>
                }
            </div>
        </div>
    </section>
    <!-- Pricing Section End -->
    <!-- Gallery Section Begin -->
