@{
    Layout = "_AccesoLayout";
    ViewData["Title"] = "Restablecer Contraseña";
}

<div class="card border-0 shadow-lg rounded-4">
    <div class="card-body p-5">
        <div class="text-center mb-4">
            <img src="~/imagenes/logo.png" width="120" class="mb-3" alt="Logo" />
            <h2 class="fw-bold">Restablecer Contraseña</h2>
            <p class="text-muted">Crea una nueva contraseña segura para tu cuenta.</p>
        </div>

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-danger text-center">
                @ViewBag.Mensaje
            </div>
        }

        <form asp-action="RestablecerPassword" asp-controller="Home" method="post">
            <input type="hidden" name="token" value="@ViewBag.Token" />

            <div class="mb-3">
                <label for="nuevaContrasenna" class="form-label">Nueva Contraseña</label>
                <div class="input-group">
                    <input type="password" id="nuevaContrasenna" name="nuevaContrasenna" class="form-control form-control-lg" placeholder="Nueva contraseña" required />
                    <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('nuevaContrasenna', this)">
                        <i class="fa fa-eye"></i>
                    </button>
                </div>
            </div>

            <div class="mb-4">
                <label for="confirmarContrasenna" class="form-label">Confirmar Nueva Contraseña</label>
                <div class="input-group">
                    <input type="password" id="confirmarContrasenna" name="confirmarContrasenna" class="form-control form-control-lg" placeholder="Confirmar contraseña" required />
                    <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('confirmarContrasenna', this)">
                        <i class="fa fa-eye"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn btn-warning w-100 btn-lg">
                Restablecer Contraseña
            </button>
        </form>
    </div>
</div>
