@model Tarea1.Models.Dtos.CrearPagoRequest
@{
    Layout = ViewData["Layout"] as string;
    ViewData["Title"] = "Registrar Pago";
}

<div class="container py-5 my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow border-0 bg-dark text-white p-4">
                <h3 class="fw-bold mb-3 text-white border-bottom border-secondary pb-2">Registrar Pago</h3>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="IdCliente" class="form-label">Cliente <span class="text-danger">*</span></label>
                        <select asp-for="IdCliente" id="ClienteSelect" class="form-select bg-secondary text-white border-0" asp-items="ViewBag.Clientes">
                            <option value="">-- Seleccione un Cliente --</option>
                        </select>
                        <span asp-validation-for="IdCliente" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="IdMembresiaCliente" class="form-label">Membresía Asociada (Opcional)</label>
                        <select asp-for="IdMembresiaCliente" id="MembresiaSelect" class="form-select bg-secondary text-white border-0">
                            <option value="" data-precio="0" data-cliente="">-- Pago sin Membresía o Asignar Luego --</option>
                            @if (ViewBag.MembresiasList != null)
                            {
                                foreach (var item in ViewBag.MembresiasList)
                                {
                                    if (Model != null && Model.IdMembresiaCliente == item.IdMembresiaCliente)
                                    {
                                        <option value="@item.IdMembresiaCliente" data-precio="@item.Precio" data-cliente="@item.IdCliente" selected="selected">@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.IdMembresiaCliente" data-precio="@item.Precio" data-cliente="@item.IdCliente">@item.Text</option>
                                    }
                                }
                            }
                        </select>
                        <span asp-validation-for="IdMembresiaCliente" class="text-danger"></span>
                    </div>

                    @if (ViewBag.ReservasPendientes != null && ((IEnumerable<Tarea1.Models.Entities.ReservaEntrenador>)ViewBag.ReservasPendientes).Any())
                    {
                        <div class="mb-3 p-3 bg-secondary rounded border border-warning">
                            <h5 class="text-warning fw-bold small mb-2"><i class="fa fa-ticket"></i> Cargos Adicionales (Reservas Pendientes)</h5>
                            @foreach (var res in (IEnumerable<Tarea1.Models.Entities.ReservaEntrenador>)ViewBag.ReservasPendientes)
                            {
                                <div class="form-check d-flex justify-content-between align-items-center mb-1">
                                    <div>
                                        <input class="form-check-input reserva-chk shadow-none" type="checkbox" name="reservasSeleccionadas" value="@res.IdReserva" id="reserva_@res.IdReserva" data-costo="@res.Costo">
                                        <label class="form-check-label text-white small ms-2" for="reserva_@res.IdReserva">
                                            Sesión con: @res.EntrenadorNombre (@res.FechaHora.ToString("dd/MM HH:mm"))
                                        </label>
                                    </div>
                                    <span class="fw-bold text-warning small">+ ₡@res.Costo.ToString("N2")</span>
                                </div>
                            }
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Monto" class="form-label">Monto (₡) <span class="text-danger">*</span></label>
                            <input asp-for="Monto" id="MontoInput" type="number" step="0.01" class="form-control bg-secondary text-white border-0" placeholder="Ej: 25000" />
                            <span asp-validation-for="Monto" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="MetodoPago" class="form-label">Método de Pago <span class="text-danger">*</span></label>
                            <select asp-for="MetodoPago" class="form-select bg-secondary text-white border-0">
                                <option value="Efectivo">Efectivo</option>
                                <option value="Tarjeta">Tarjeta de Crédito / Débito</option>
                                <option value="Transferencia">Transferencia Bancaria</option>
                                <option value="SINPE Movil">SINPE Móvil</option>
                            </select>
                            <span asp-validation-for="MetodoPago" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Estado" class="form-label">Estado de Transacción <span class="text-danger">*</span></label>
                        <select asp-for="Estado" class="form-select bg-secondary text-white border-0">
                            <option value="Pagado">Pagado</option>
                            <option value="Pendiente">Pendiente</option>
                        </select>
                        <span asp-validation-for="Estado" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-light">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">Registrar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var selectMembresia = document.getElementById("MembresiaSelect");
            var inputMonto = document.getElementById("MontoInput");
            var selectCliente = document.getElementById("ClienteSelect");
            var chksReservas = document.querySelectorAll(".reserva-chk");

            function calcularTotal() {
                var selectedOption = selectMembresia.options[selectMembresia.selectedIndex];
                var precioBase = parseFloat(selectedOption.getAttribute("data-precio") || "0");
                var total = precioBase;

                chksReservas.forEach(function (chk) {
                    if (chk.checked) {
                        total += parseFloat(chk.getAttribute("data-costo") || "0");
                    }
                });

                inputMonto.value = total.toFixed(2);
            }

            selectMembresia.addEventListener("change", function () {
                var selectedOption = this.options[this.selectedIndex];
                var precio = selectedOption.getAttribute("data-precio");
                var clienteId = selectedOption.getAttribute("data-cliente");

                if (clienteId) {
                    selectCliente.value = clienteId;
                    // Recargar con el idCliente para jalar sus reservas si cambian
                    window.location.href = '@Url.Action("Create", "Pagos")?idCliente=' + clienteId + '&idMembresiaCliente=' + this.value;
                } else {
                    calcularTotal();
                }
            });

            chksReservas.forEach(function (chk) {
                chk.addEventListener("change", calcularTotal);
            });

            selectCliente.addEventListener("change", function() {
                var val = this.value;
                if(val) {
                    window.location.href = '@Url.Action("Create", "Pagos")?idCliente=' + val;
                }
            });

            // Ejecutar cálculo inicial
            calcularTotal();
        });
    </script>
}
