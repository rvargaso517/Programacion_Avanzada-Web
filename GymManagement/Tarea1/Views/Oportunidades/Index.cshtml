@model IEnumerable<Tarea1.Models.Dtos.OportunidadDto>
@using Microsoft.AspNetCore.Http

@{
    Layout = ViewData["Layout"] as string;
    ViewData["Title"] = "Oportunidades";

    var puedeAdministrar =
        Context.Session.GetInt32("Rol") == 1 ||
        Context.Session.GetInt32("Rol") == 2;
}

<div class="container oportunidades-container">

    <div class="oportunidades-header">

        <div class="d-flex justify-content-between align-items-center flex-wrap">

            <div>

                <h2>
                    <i class="fa fa-line-chart me-2"></i>
                    Gestión de Oportunidades
                </h2>

                <p>
                    Administra y da seguimiento a las oportunidades comerciales.
                </p>

            </div>

            @if (puedeAdministrar)
            {
                <a asp-action="Create"
                   class="btn btn-primary btn-nueva">

                    <i class="fa fa-plus me-2"></i>
                    Nueva Oportunidad

                </a>
            }

        </div>

    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success custom-alert alert-dismissible fade show">

            <i class="fa fa-check-circle me-2"></i>

            @TempData["Exito"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger custom-alert alert-dismissible fade show">

            <i class="fa fa-exclamation-circle me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <div class="filtros-card">

        <div class="filtros-title">

            <i class="fa fa-filter me-2 text-primary"></i>
            Buscar y filtrar oportunidades

        </div>


        <form method="get">

            <div class="row g-3">

                <div class="col-md-3">

                    <label for="buscar"
                           class="filtro-label">

                        Buscar por título / descripción

                    </label>

                    <input type="text"
                           name="buscar"
                           id="buscar"
                           class="form-control filtro-control"
                           placeholder="Escriba aquí..."
                           value="@ViewBag.Buscar" />

                </div>

                <div class="col-md-3">

                    <label for="idCliente"
                           class="filtro-label">

                        Cliente

                    </label>

                    <select name="idCliente"
                            id="idCliente"
                            class="form-select filtro-control"
                            asp-items="ViewBag.Clientes">

                        <option value="">
                            -- Todos los Clientes --
                        </option>

                    </select>

                </div>

                <div class="col-md-3">

                    <label for="etapa"
                           class="filtro-label">

                        Etapa

                    </label>

                    <select name="etapa"
                            id="etapa"
                            class="form-select filtro-control"
                            asp-items="ViewBag.Etapas">

                        <option value="">
                            -- Todas las Etapas --
                        </option>

                    </select>

                </div>

                <div class="col-md-2">

                    <label for="estado"
                           class="filtro-label">

                        Estado

                    </label>

                    <select name="estado"
                            id="estado"
                            class="form-select filtro-control">

                        <option value="">
                            Todos
                        </option>

                        @if (ViewBag.Estado == true)
                        {
                            <option value="true" selected>
                                Activas
                            </option>

                            <option value="false">
                                Inactivas
                            </option>
                        }
                        else if (ViewBag.Estado == false)
                        {
                            <option value="true">
                                Activas
                            </option>

                            <option value="false" selected>
                                Inactivas
                            </option>
                        }
                        else
                        {
                            <option value="true">
                                Activas
                            </option>

                            <option value="false">
                                Inactivas
                            </option>
                        }

                    </select>

                </div>

                <div class="col-md-1 d-flex align-items-end gap-2">

                    <button type="submit"
                            class="btn btn-primary btn-filtrar w-100"
                            title="Filtrar">

                        <i class="fa fa-filter"></i>

                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary btn-limpiar w-100"
                       title="Limpiar">

                        <i class="fa fa-refresh"></i>

                    </a>

                </div>

            </div>

        </form>

    </div>

    <div class="oportunidades-card">

        <div class="tabla-header">

            <h5>

                <i class="fa fa-list me-2 text-primary"></i>

                Lista de oportunidades

            </h5>

            <span class="cantidad-oportunidades">

                @Model.Count() oportunidades

            </span>

        </div>


        <div class="table-responsive">

            <table class="table oportunidades-table">

                <thead>

                    <tr>

                        <th>Cliente</th>

                        <th>Título</th>

                        <th>Monto</th>

                        <th>Etapa</th>

                        <th>Cierre estimado</th>

                        <th>Estado</th>

                        <th class="text-end">
                            Acciones
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="7">

                                <div class="empty-state">

                                    <div class="empty-icon">

                                        <i class="fa fa-line-chart"></i>

                                    </div>

                                    <h5>
                                        No hay oportunidades
                                    </h5>

                                    <p>
                                        No se encontraron oportunidades comerciales.
                                    </p>

                                </div>

                            </td>

                        </tr>
                    }


                    @foreach (var o in Model)
                    {
                        <tr>

                            <td>

                                <a asp-controller="Clientes"
                                   asp-action="Details"
                                   asp-route-id="@o.IdCliente"
                                   class="cliente-link">

                                    <span class="cliente-icon">

                                        <i class="fa fa-user"></i>

                                    </span>

                                    @o.ClienteNombreCompleto

                                </a>

                            </td>

                            <td>

                                <div class="oportunidad-titulo">
                                    @o.Titulo
                                </div>

                                <span class="oportunidad-descripcion">
                                    @o.Descripcion
                                </span>

                            </td>

                            <td>

                                <span class="monto">

                                    @o.MontoEstimado.ToString("C2")

                                </span>

                            </td>

                            <td>

                                @switch (o.Etapa)
                                {
                                    case "Nuevo":

                                        <span class="etapa-badge etapa-nuevo">
                                            <i class="fa fa-circle me-1"></i>
                                            Nuevo
                                        </span>

                                        break;

                                    case "En Contacto":

                                        <span class="etapa-badge etapa-contacto">
                                            <i class="fa fa-circle me-1"></i>
                                            En Contacto
                                        </span>

                                        break;

                                    case "Propuesta":

                                        <span class="etapa-badge etapa-propuesta">
                                            <i class="fa fa-circle me-1"></i>
                                            Propuesta
                                        </span>

                                        break;

                                    case "Ganada":

                                        <span class="etapa-badge etapa-ganada">
                                            <i class="fa fa-check-circle me-1"></i>
                                            Ganada
                                        </span>

                                        break;

                                    case "Perdida":

                                        <span class="etapa-badge etapa-perdida">
                                            <i class="fa fa-times-circle me-1"></i>
                                            Perdida
                                        </span>

                                        break;

                                    default:

                                        <span class="etapa-badge etapa-default">

                                            @o.Etapa

                                        </span>

                                        break;
                                }

                            </td>

                            <td>

                                <span class="fecha-cierre">

                                    <i class="fa fa-calendar"></i>

                                    @(o.FechaCierre?.ToString("dd/MM/yyyy") ?? "-")

                                </span>

                            </td>

                            <td>

                                @if (o.Estado)
                                {
                                    <span class="estado-badge estado-activa">

                                        <i class="fa fa-circle"></i>

                                        Activa

                                    </span>
                                }
                                else
                                {
                                    <span class="estado-badge estado-inactiva">

                                        <i class="fa fa-circle"></i>

                                        Inactiva

                                    </span>
                                }

                            </td>

                            <td>

                                <div class="acciones">
>
                                    <a asp-action="Details"
                                       asp-route-id="@o.IdOportunidad"
                                       class="btn btn-outline-info btn-accion">

                                        <i class="fa fa-eye me-1"></i>
                                        Ver

                                    </a>


                                    @if (puedeAdministrar)
                                    {
          
                                        <a asp-action="Edit"
                                           asp-route-id="@o.IdOportunidad"
                                           class="btn btn-outline-primary btn-accion">

                                            <i class="fa fa-pencil me-1"></i>
                                            Editar

                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@o.IdOportunidad"
                                           class="btn btn-outline-danger btn-accion">

                                            <i class="fa fa-trash me-1"></i>
                                            Eliminar

                                        </a>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>