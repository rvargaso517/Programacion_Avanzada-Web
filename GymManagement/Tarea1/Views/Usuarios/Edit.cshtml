@model Tarea1.Models.Dtos.ActualizarUsuarioRequest
@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container py-5 my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h3 class="fw-bold mb-4">Editar Usuario</h3>

                    <form method="post" asp-action="Edit">
                        <input type="hidden" asp-for="IdUsuario" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                        <div class="mb-3">
                            <label class="form-label" asp-for="Nombre"></label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" asp-for="Correo"></label>
                            <input asp-for="Correo" class="form-control" />
                            <span asp-validation-for="Correo" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" asp-for="IdRol"></label>
                            <select asp-for="IdRol" class="form-select" asp-items="ViewBag.Roles">
                                <option value="">-- Seleccione un rol --</option>
                            </select>
                            <span asp-validation-for="IdRol" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="Estado" class="form-check-input" />
                            <label class="form-check-label" asp-for="Estado"></label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Actualizar</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
