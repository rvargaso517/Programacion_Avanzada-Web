@using Microsoft.AspNetCore.Http
@using Tarea1.Helpers
<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>@ViewData["Title"] - Gym Management</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Muli:300,400,500,600,700,800,900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Oswald:300,400,500,600,700&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- FontAwesome -->
    <link rel="stylesheet" href="~/css/font-awesome.min.css">

    <!-- FullCalendar -->
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.18/index.global.min.css" rel="stylesheet">

    <!-- Estilos propios -->
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true">
</head>

<body class="bg-light">

    <!-- NAVBAR -->

    <nav class="navbar navbar-dark bg-dark shadow-sm">

        <div class="container-fluid">

            <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">

                <img src="~/imagenes/logo.png"
                     style="height:45px"
                     class="me-3" />

                Gym Management

            </a>

            <div>

                <span class="text-white me-3">

                    Hola @Context.Session.GetString("Nombre")

                </span>

                <form asp-controller="Home"
                      asp-action="Logout"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <button class="btn btn-danger">

                        Salir

                    </button>

                </form>

            </div>

        </div>

    </nav>

    <!-- CONTENIDO -->

    <div class="container-fluid">

        <div class="row">

            <!-- SIDEBAR -->

            <div class="col-md-2 sidebar p-0">

                <div class="list-group rounded-0">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="list-group-item text-primary fw-bold">

                        <i class="fa fa-globe me-2"></i>

                        Ver Sitio Web

                    </a>

                    @if (PermisosHelper.TieneAcceso(Context.Session.GetInt32("Rol") ?? 0, "Dashboard"))
                    {
                        <a asp-controller="Dashboard"
                           asp-action="Index"
                           class="list-group-item">
                            <i class="fa fa-dashboard me-2"></i>
                            Dashboard
                        </a>
                    }

                    @if (PermisosHelper.TieneAcceso(Context.Session.GetInt32("Rol") ?? 0, "Clientes"))
                    {
                        <a asp-controller="Clientes"
                           asp-action="Index"
                           class="list-group-item">
                            <i class="fa fa-users me-2"></i>
                            Clientes
                        </a>
                    }

                    @if (PermisosHelper.TieneAcceso(Context.Session.GetInt32("Rol") ?? 0, "Oportunidades"))
                    {
                        <a asp-controller="Oportunidades"
                           asp-action="Index"
                           class="list-group-item">
                            <i class="fa fa-line-chart me-2"></i>
                            Oportunidades
                        </a>
                    }

                    @if (PermisosHelper.TieneAcceso(Context.Session.GetInt32("Rol") ?? 0, "Planes"))
                    {
                        <a asp-controller="Planes"
                           asp-action="Index"
                           class="list-group-item">
                            <i class="fa fa-list-alt me-2"></i>
                            Planes
                        </a>
                    }

                    @if (PermisosHelper.TieneAcceso(Context.Session.GetInt32("Rol") ?? 0, "Membresias"))
                    {
                        <a asp-controller="Membresias"
                           asp-action="Index"
                           class="list-group-item">
                            <i class="fa fa-id-card me-2"></i>
                            Membresías
                        </a>
                    }

                    @if (PermisosHelper.TieneAcceso(Context.Session.GetInt32("Rol") ?? 0, "Agenda"))
                    {
                        <a asp-controller="Citas"
                           asp-action="Index"
                           class="list-group-item">
                            <i class="fa fa-calendar me-2"></i>
                            Agenda
                        </a>
                    }

                    @if (PermisosHelper.TieneAcceso(Context.Session.GetInt32("Rol") ?? 0, "Rutinas"))
                    {
                        <a asp-controller="Rutinas"
                           asp-action="Index"
                           class="list-group-item">
                            <i class="fa fa-heartbeat me-2"></i>
                            Rutinas
                        </a>
                    }

                    @if (PermisosHelper.TieneAcceso(Context.Session.GetInt32("Rol") ?? 0, "Reservas"))
                    {
                        <a asp-controller="Reservas"
                           asp-action="Index"
                           class="list-group-item">
                            <i class="fa fa-ticket me-2"></i>
                            Reservas
                        </a>
                    }

                    @if (PermisosHelper.TieneAcceso(Context.Session.GetInt32("Rol") ?? 0, "Pagos"))
                    {
                        <a asp-controller="Pagos"
                           asp-action="Index"
                           class="list-group-item">
                            <i class="fa fa-credit-card me-2"></i>
                            Pagos
                        </a>
                    }

                    @if (PermisosHelper.TieneAcceso(Context.Session.GetInt32("Rol") ?? 0, "Usuarios"))
                    {
                        <a asp-controller="Usuarios"
                           asp-action="Index"
                           class="list-group-item">
                            <i class="fa fa-user-secret me-2"></i>
                            Usuarios
                        </a>
                    }

                    @if (PermisosHelper.TieneAcceso(Context.Session.GetInt32("Rol") ?? 0, "Contenido Web"))
                    {
                        <a asp-controller="Contenido"
                           asp-action="Index"
                           class="list-group-item">
                            <i class="fa fa-edit me-2"></i>
                            Contenido Web
                        </a>
                    }

                    <a asp-controller="Usuario"
                       asp-action="Perfil"
                       class="list-group-item">
                        <i class="fa fa-user me-2"></i>
                        Perfil
                    </a>

                </div>

            </div>

            <!-- CONTENIDO -->

            <div class="col-md-10 p-4">

                @RenderBody()

            </div>

        </div>

    </div>

    <!-- JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.18/index.global.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>

</html>
