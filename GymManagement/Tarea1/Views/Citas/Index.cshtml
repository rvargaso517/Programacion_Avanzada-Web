@using Microsoft.AspNetCore.Http
@{
    Layout = ViewData["Layout"] as string;
    ViewData["Title"] = "Agenda";
    var isStaff = Context.Session.GetInt32("Rol") == 1 || Context.Session.GetInt32("Rol") == 2 || Context.Session.GetInt32("Rol") == 3;
}

<div class="@(isStaff ? "container-fluid" : "container py-5 my-5")">
    <div class="card shadow border-0 @(isStaff ? "" : "bg-dark text-white p-4")">
        <div class="card-header d-flex justify-content-between align-items-center @(isStaff ? "bg-light text-dark" : "bg-dark border-secondary text-white")">
            <h3 class="mb-0 fw-bold">
                Agenda de Citas
            </h3>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fa fa-calendar-plus-o"></i> Nueva Cita
            </a>
        </div>
        <div class="card-body bg-white text-dark rounded-bottom p-4">
            <div id="calendar"></div>
        </div>
    </div>
</div>

<!-- Modal Detalles de Cita -->
<div class="modal fade" id="modalDetalleCita" tabindex="-1" aria-labelledby="modalDetalleCitaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="modalDetalleCitaLabel">
                    <i class="fa fa-info-circle text-primary me-2"></i>Detalles de la Cita
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-dark">
                <div class="mb-3 border-bottom pb-2">
                    <label class="text-muted small fw-bold uppercase">Título / Actividad</label>
                    <div id="detalleTitulo" class="fs-5 fw-bold text-dark"></div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6 border-bottom pb-2">
                        <label class="text-muted small fw-bold uppercase">Cliente</label>
                        <div id="detalleCliente" class="fw-semibold"></div>
                    </div>
                    <div class="col-md-6 border-bottom pb-2">
                        <label class="text-muted small fw-bold uppercase">Entrenador</label>
                        <div id="detalleEntrenador" class="fw-semibold"></div>
                    </div>
                </div>
                <div class="mb-3 border-bottom pb-2">
                    <label class="text-muted small fw-bold uppercase">Fecha y Hora</label>
                    <div id="detalleFechaHora" class="fw-semibold"></div>
                </div>
                <div class="mb-3 border-bottom pb-2">
                    <label class="text-muted small fw-bold uppercase">Descripción</label>
                    <div id="detalleDescripcion" class="text-secondary"></div>
                </div>
                <div class="mb-1">
                    <label class="text-muted small fw-bold uppercase d-block mb-1">Estado</label>
                    <span id="detalleEstado" class="badge px-3 py-2 fs-6"></span>
                </div>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/citas.js" asp-append-version="true"></script>
}
