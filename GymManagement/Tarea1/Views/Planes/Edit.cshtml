@model Tarea1.Models.Dtos.ActualizarPlanRequest
@{
    Layout = ViewData["Layout"] as string;
    ViewData["Title"] = "Editar Plan de Membresía";
}

<div class="container py-5 my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow border-0 bg-dark text-white p-4">
                <h3 class="fw-bold mb-3 text-white border-bottom border-secondary pb-2">Editar Plan de Membresía</h3>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="IdPlan" />

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label">Nombre del Plan <span class="text-danger">*</span></label>
                        <input asp-for="Nombre" class="form-control bg-secondary text-white border-0" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label">Descripción</label>
                        <textarea asp-for="Descripcion" rows="3" class="form-control bg-secondary text-white border-0"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DuracionDias" class="form-label">Duración (Días) <span class="text-danger">*</span></label>
                            <input asp-for="DuracionDias" type="number" class="form-control bg-secondary text-white border-0" />
                            <span asp-validation-for="DuracionDias" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Precio" class="form-label">Precio (₡) <span class="text-danger">*</span></label>
                            <input asp-for="Precio" type="number" step="0.01" class="form-control bg-secondary text-white border-0" />
                            <span asp-validation-for="Precio" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4 form-check form-switch">
                        <input asp-for="Estado" type="checkbox" class="form-check-input" />
                        <label asp-for="Estado" class="form-check-label ms-2">Plan Activo</label>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-light">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">Actualizar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
