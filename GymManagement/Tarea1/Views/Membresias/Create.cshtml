@model Tarea1.Models.Dtos.CrearMembresiaRequest
@{
    Layout = ViewData["Layout"] as string;
    ViewData["Title"] = "Asignar Membresía";
}

<div class="container py-5 my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow border-0 bg-dark text-white p-4">
                <h3 class="fw-bold mb-3 text-white border-bottom border-secondary pb-2">Asignar Membresía a Cliente</h3>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    @if (Context.Session.GetInt32("Rol") == 4)
                    {
                        <input type="hidden" asp-for="IdCliente" />
                        <div class="mb-3">
                            <label class="form-label">Cliente</label>
                            <input type="text" class="form-control bg-secondary text-white border-0" value="@Context.Session.GetString("Nombre")" readonly />
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label asp-for="IdCliente" class="form-label">Cliente <span class="text-danger">*</span></label>
                            <select asp-for="IdCliente" class="form-select bg-secondary text-white border-0" asp-items="ViewBag.Clientes">
                                <option value="">-- Seleccione un Cliente --</option>
                            </select>
                            <span asp-validation-for="IdCliente" class="text-danger"></span>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="IdPlan" class="form-label">Plan de Membresía <span class="text-danger">*</span></label>
                        <select asp-for="IdPlan" class="form-select bg-secondary text-white border-0" asp-items="ViewBag.Planes">
                            <option value="">-- Seleccione un Plan --</option>
                        </select>
                        <span asp-validation-for="IdPlan" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FechaInicio" class="form-label">Fecha de Inicio <span class="text-danger">*</span></label>
                            <input asp-for="FechaInicio" type="date" class="form-control bg-secondary text-white border-0" />
                            <span asp-validation-for="FechaInicio" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="FechaFin" class="form-label">Fecha de Vencimiento <span class="text-danger">*</span></label>
                            <input asp-for="FechaFin" type="date" class="form-control bg-secondary text-white border-0" />
                            <span asp-validation-for="FechaFin" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4 form-check form-switch">
                        <input asp-for="Estado" type="checkbox" class="form-check-input" checked />
                        <label asp-for="Estado" class="form-check-label ms-2">Membresía Activa</label>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-light">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">Asignar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const planesInfo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.PlanesList));
        
        function calcularVencimiento() {
            const planSelect = document.getElementById("IdPlan");
            const fechaInicioInput = document.getElementById("FechaInicio");
            const fechaFinInput = document.getElementById("FechaFin");

            if (!planSelect.value || !fechaInicioInput.value) return;

            const selectedPlanId = parseInt(planSelect.value);
            const plan = planesInfo.find(p => p.IdPlan === selectedPlanId);

            if (plan) {
                const startDate = new Date(fechaInicioInput.value + "T12:00:00");
                startDate.setDate(startDate.getDate() + plan.DuracionDias);
                
                const year = startDate.getFullYear();
                const month = String(startDate.getMonth() + 1).padStart(2, '0');
                const day = String(startDate.getDate()).padStart(2, '0');
                
                fechaFinInput.value = `${year}-${month}-${day}`;
            }
        }

        document.getElementById("IdPlan").addEventListener("change", calcularVencimiento);
        document.getElementById("FechaInicio").addEventListener("change", calcularVencimiento);
        
        // Trigger on load for pre-selected plan
        calcularVencimiento();
    </script>
}
