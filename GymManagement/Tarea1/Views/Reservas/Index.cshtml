@model IEnumerable<Tarea1.Models.Entities.ReservaEntrenador>
@{
    Layout = ViewData["Layout"] as string;
    ViewData["Title"] = "Reservas de Clases y Entrenador";
    var userRol = Context.Session.GetInt32("Rol");
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-dark">Reservas del Gimnasio</h1>
            <p class="text-muted">Gestiona tus citas con entrenadores personales y reservaciones de clases.</p>
        </div>
        @if (userRol == 4)
        {
            <a asp-action="Create" class="btn btn-warning rounded-pill px-4 fw-bold">
                + Nueva Reserva
            </a>
        }
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show text-center rounded-3 shadow-sm" role="alert">
            @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            @if (userRol != 4)
                            {
                                <th class="py-3">Cliente</th>
                            }
                            <th class="py-3">Entrenador</th>
                            <th class="py-3">Fecha y Hora</th>
                            <th class="py-3">Costo</th>
                            <th class="py-3">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No se encontraron reservas registradas.</td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                @if (userRol != 4)
                                {
                                    <td class="py-3 fw-bold">@item.ClienteNombre</td>
                                }
                                <td class="py-3">@item.EntrenadorNombre</td>
                                <td class="py-3 text-muted">@item.FechaHora.ToString("dd/MM/yyyy hh:mm tt")</td>
                                <td class="py-3 fw-bold text-success">₡@item.Costo.ToString("N2")</td>
                                <td class="py-3">
                                    @if (item.Estado == "Pagado")
                                    {
                                        <span class="badge bg-success text-white px-3 py-2 rounded-pill">Pagado</span>
                                    }
                                    else if (item.Estado == "Pendiente")
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">Pendiente de Pago</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-white px-3 py-2 rounded-pill">@item.Estado</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
