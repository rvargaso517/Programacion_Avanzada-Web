@{
    Layout = ViewData["Layout"] as string;
    ViewData["Title"] = "Programar Reserva";
    var entrenadores = ViewBag.Entrenadores as IEnumerable<Tarea1.Models.Entities.Usuario> ?? new List<Tarea1.Models.Entities.Usuario>();
}

<div class="container my-5" style="max-width: 600px;">
    <div class="mb-4">
        <h1 class="fw-bold text-dark">Nueva Reserva</h1>
        <p class="text-muted">Reserva tu entrenador personal o clase dirigida. Cada sesión tiene un valor de <strong class="text-dark">₡10,000.00</strong>.</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger rounded-3" asp-validation-summary="All"></div>
    }

    <form asp-action="Create" method="post" class="needs-validation" novalidate>
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <div class="mb-3">
                    <label for="idEntrenador" class="form-label fw-semibold">Seleccionar Entrenador</label>
                    <select id="idEntrenador" name="idEntrenador" class="form-select" required>
                        <option value="" disabled selected>-- Elija un Entrenador --</option>
                        @foreach (var ent in entrenadores)
                        {
                            <option value="@ent.IdUsuario">@ent.Nombre</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label for="fechaHora" class="form-label fw-semibold">Fecha y Hora de la Sesión</label>
                    <input type="datetime-local" id="fechaHora" name="fechaHora" class="form-control" required />
                </div>

                <div class="p-3 bg-light rounded-3 d-flex justify-content-between align-items-center">
                    <span class="text-muted">Monto total a liquidar en caja:</span>
                    <h4 class="fw-bold text-success mb-0">₡10,000.00</h4>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                Cancelar
            </a>
            <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold">
                Confirmar Reserva
            </button>
        </div>
    </form>
</div>
